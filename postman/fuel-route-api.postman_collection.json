{
  "info": {
    "name": "Fuel Route API",
    "description": "Demo requests for POST /api/route/. Set the baseUrl variable if the server is not on http://127.0.0.1:8000.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    }
  ],
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "health",
            ""
          ]
        }
      }
    },
    {
      "name": "Long route - New York to Los Angeles (multiple stops)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"start\": \"New York, NY\",\n    \"finish\": \"Los Angeles, CA\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/routes/calculate/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "routes",
            "calculate",
            ""
          ]
        }
      }
    },
    {
      "name": "Medium route - Chicago to Denver",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"start\": \"Chicago, IL\",\n    \"finish\": \"Denver, CO\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/routes/calculate/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "routes",
            "calculate",
            ""
          ]
        }
      }
    },
    {
      "name": "Short route - Dallas to Houston (no stop needed)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"start\": \"Dallas, TX\",\n    \"finish\": \"Houston, TX\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/routes/calculate/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "routes",
            "calculate",
            ""
          ]
        }
      }
    },
    {
      "name": "Error - missing finish (400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"start\": \"New York, NY\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/routes/calculate/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "routes",
            "calculate",
            ""
          ]
        }
      }
    },
    {
      "name": "Error - location outside USA (422)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"start\": \"Paris, France\",\n    \"finish\": \"Los Angeles, CA\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/routes/calculate/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "routes",
            "calculate",
            ""
          ]
        }
      }
    },
    {
      "name": "Fuel stations - list (Texas, cheapest first)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/fuel-stations/?state=TX&ordering=price&page_size=20",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "fuel-stations",
            ""
          ],
          "query": [
            {
              "key": "state",
              "value": "TX"
            },
            {
              "key": "ordering",
              "value": "price"
            },
            {
              "key": "page_size",
              "value": "20"
            }
          ]
        }
      }
    },
    {
      "name": "Fuel stations - search",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/fuel-stations/?search=pilot&max_price=3.50",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "fuel-stations",
            ""
          ],
          "query": [
            {
              "key": "search",
              "value": "pilot"
            },
            {
              "key": "max_price",
              "value": "3.50"
            }
          ]
        }
      }
    },
    {
      "name": "Fuel stations - view one",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/fuel-stations/7/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "fuel-stations",
            "7",
            ""
          ]
        }
      }
    },
    {
      "name": "Fuel stations - add",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/fuel-stations/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "fuel-stations",
            ""
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n    \"opis_id\": 999001,\n    \"name\": \"DEMO TRUCK STOP\",\n    \"address\": \"I-40 EXIT 70\",\n    \"city\": \"Amarillo\",\n    \"state\": \"TX\",\n    \"rack_id\": 1,\n    \"retail_price\": 3.159\n}"
        }
      }
    },
    {
      "name": "Fuel stations - replace (PUT)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/fuel-stations/999001/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "fuel-stations",
            "999001",
            ""
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n    \"opis_id\": 999001,\n    \"name\": \"DEMO TRUCK STOP RENAMED\",\n    \"address\": \"I-10 EXIT 1\",\n    \"city\": \"El Paso\",\n    \"state\": \"TX\",\n    \"rack_id\": 1,\n    \"retail_price\": 2.999\n}"
        }
      }
    },
    {
      "name": "Fuel stations - partial update (PATCH)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/fuel-stations/999001/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "fuel-stations",
            "999001",
            ""
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n    \"retail_price\": 2.899\n}"
        }
      }
    },
    {
      "name": "Fuel stations - delete",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/fuel-stations/999001/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "fuel-stations",
            "999001",
            ""
          ]
        }
      }
    }
  ]
}