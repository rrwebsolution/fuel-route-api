# Copy to .env and adjust. Never commit the real .env file.

# Django
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL / MariaDB (Django 6.1 needs MySQL 8.4+ or MariaDB 10.11+)
DB_NAME=fuel_route_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# External services (free, no API keys required)
# Nominatim requires an identifying User-Agent; add your contact URL/email for heavy use.
# Placeholder addresses such as example.com are rejected with HTTP 403.
GEOCODING_USER_AGENT=fuel-route-api/1.0 (local development)
GEOCODING_URL=https://nominatim.openstreetmap.org/search
ROUTING_URL=https://router.project-osrm.org/route/v1/driving
EXTERNAL_API_TIMEOUT_SECONDS=15
GEOCODING_CACHE_SECONDS=2592000
ROUTING_CACHE_SECONDS=86400

# Trip planning
VEHICLE_START_TANK_FRACTION=1.0
STATION_CORRIDOR_MILES=10
FUEL_MIN_SAVINGS_PER_GALLON=0.10
ROUTE_GEOMETRY_SIMPLIFY_TOLERANCE=0.0005
